          "guardrails": ["主体与镜头距离 ≥1.5m，避免近大远小失真"],
          "quota": { "min": 5, "max": 8 }
        },
        {
          "code": "F38",
          "mm": 38,
          "label": "38mm 交代档",
          "effect": "接近人眼但带出环境关系",
