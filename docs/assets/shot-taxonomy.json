        },
        {
          "code": "F40",
          "mm": 40,
          "label": "40mm 交代档",
          "effect": "环境与主体权重接近 1:1",
          "allowedThemeLines": ["*"],
          "guardrails": [],
          "quota": { "min": 5, "max": 7 }
        },
        {
          "code": "F44",
          "mm": 44,
          "label": "44mm 主力",
          "effect": "人眼视角，主体确定、环境仍完整",
