  "prompt": {
    "styleBase": "photorealistic documentary photograph, muted low-saturation film color, soft natural contrast, fine grain, gentle highlight rolloff, natural skin and material tones; vertical 2:3 framing; background stays legible with at least one discernible secondary element; no readable text of any kind, no signage lettering, no brand, no logo, no watermark; any person shown from behind or in profile or head lowered, face softened and unidentifiable, whole body inside the frame and never cut by the frame edge",
    "template": "{THEME_SCENE}, {REGION_LOOK}, {ERA_PROPS}, shot on {FOCAL}mm lens at {APERTURE}, {FRAMING_EN}, {DAYPART_LIGHT}, {SUBJECT_CLAUSE}{ABSENCE_CLAUSE}. {STYLE_BASE}",
