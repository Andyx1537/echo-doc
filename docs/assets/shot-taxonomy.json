    "baselineCount": 43,
    "aspectRatio": "2:3",
    "purpose": "供脚本做组合生成、配额校验与去重；不含任何图片本身",
    "formatRationale": "选 JSON 而非 TypeScript 常量：出图侧是 Python/Shell 脚本，前端与文档亦需读取；JSON 语言中立、可直接被 jq/校验器消费，且不会被误当成运行时业务代码打进前端包"
  },

  "dimensions": {
    "focal": {
      "label": "焦距",
      "unit": "mm",
      "rule": "主力 44/50；38-40 用于交代地点；28/35 为受限广角档；85 已废除",
      "values": [
        {
          "code": "F28",
          "mm": 28,
          "label": "28mm 广角",
          "effect": "纵深强、边缘有畸变、容易把主体推远",
          "allowedThemeLines": ["campus", "transit", "factory", "leisure", "season"],
          "guardrails": [
            "画面近处必须有可辨识前景锚点（栏杆/课桌角/车把/雪堆/板凳）",
            "主体高度不小于画面高度的 1/5",
            "人脸不得靠近画框边缘（畸变会拉脸）"
